@{
    ViewData["Title"] = "Для тебя";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    /* Экран приветствия */
    #intro-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg, #1a0033 0%, #330066 50%, #660099 100%);
        z-index: 10000;
        display: flex;
        justify-content: center;
        align-items: center;
        flex-direction: column;
        transition: opacity 1s ease-out;
    }

        #intro-overlay h1 {
            font-size: 4rem;
            color: #ff69b4;
            text-shadow: 0 0 30px rgba(255, 105, 180, 0.8);
            margin-bottom: 20px;
            animation: glow 2s infinite alternate;
        }

        #intro-overlay p {
            font-size: 1.5rem;
            color: white;
            margin-bottom: 40px;
            text-align: center;
            padding: 0 20px;
        }

    #start-btn {
        padding: 15px 50px;
        font-size: 1.5rem;
        background: linear-gradient(135deg, #ff69b4, #ff1493);
        color: white;
        border: none;
        border-radius: 50px;
        cursor: pointer;
        box-shadow: 0 0 30px rgba(255, 105, 180, 0.6);
        transition: transform 0.3s;
        z-index: 10001;
        position: relative;
    }

        #start-btn:hover {
            transform: scale(1.1);
        }

    body {
        background: linear-gradient(135deg, #1a0033 0%, #330066 50%, #660099 100%);
        min-height: 100vh;
        font-family: 'Segoe UI', sans-serif;
        overflow-x: hidden;
        color: white;
    }

    .stars {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: 0;
    }

    .star {
        position: absolute;
        background: white;
        border-radius: 50%;
        animation: twinkle 3s infinite;
    }

    @@keyframes twinkle {
        0%, 100% {
            opacity: 0.3;
        }

        50% {
            opacity: 1;
        }
    }

    .planet {
        position: fixed;
        top: 10%;
        right: 10%;
        width: 200px;
        height: 200px;
        background: radial-gradient(circle at 30% 30%, #ff69b4, #ff1493, #c71585);
        border-radius: 50%;
        box-shadow: 0 0 60px rgba(255, 105, 180, 0.6), inset -20px -20px 40px rgba(0,0,0,0.3);
        animation: float 6s ease-in-out infinite;
        z-index: 1;
    }

    @@keyframes float {
        0%, 100% {
            transform: translateY(0px);
        }

        50% {
            transform: translateY(-20px);
        }
    }

    .content {
        position: relative;
        z-index: 10;
        padding: 40px 20px;
        max-width: 1200px;
        margin: 0 auto;
    }

    h1 {
        font-size: 3rem;
        text-align: center;
        margin-bottom: 20px;
        text-shadow: 0 0 20px rgba(255, 105, 180, 0.8);
    }

    @@keyframes glow {
        from {
            text-shadow: 0 0 20px rgba(255, 105, 180, 0.8);
        }

        to {
            text-shadow: 0 0 30px rgba(255, 105, 180, 1), 0 0 40px rgba(255, 20, 147, 0.8);
        }
    }

    .subtitle {
        text-align: center;
        font-size: 1.5rem;
        margin-bottom: 40px;
        color: #ffb6c1;
    }

    .swiper {
        width: 100%;
        max-width: 800px;
        height: 450px;
        margin: 40px auto;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 0 40px rgba(255, 105, 180, 0.5);
        border: 3px solid #ff69b4;
    }

    .swiper-slide img, .swiper-slide video {
        width: 100%;
        height: 100%;
        object-fit: contain;
        background: rgba(0,0,0,0.3);
    }

    .languages-section {
        margin: 80px 0;
        text-align: center;
    }

    .languages-title {
        font-size: 2.5rem;
        margin-bottom: 40px;
        color: #ff69b4;
        text-shadow: 0 0 20px rgba(255, 105, 180, 0.6);
    }

    .lang-grid {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 12px;
        max-width: 1400px;
        margin: 0 auto;
    }

    .lang-item {
        background: rgba(255, 105, 180, 0.15);
        backdrop-filter: blur(5px);
        padding: 10px 20px;
        border-radius: 50px;
        color: white;
        font-size: 1rem;
        font-style: italic;
        border: 1px solid rgba(255, 105, 180, 0.4);
        box-shadow: 0 4px 15px rgba(255, 105, 180, 0.2);
        opacity: 0;
        animation: fadeInUp 0.5s ease-out forwards;
        transition: all 0.3s;
    }

        .lang-item:hover {
            transform: translateY(-3px) scale(1.05);
            background: rgba(255, 105, 180, 0.3);
        }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .quiz-section {
        margin: 80px 0;
        padding: 40px;
        background: rgba(255, 105, 180, 0.1);
        border-radius: 30px;
        border: 2px solid rgba(255, 105, 180, 0.3);
        backdrop-filter: blur(10px);
    }

    .quiz-title {
        font-size: 2.5rem;
        text-align: center;
        margin-bottom: 30px;
        color: #ff69b4;
    }

    .quiz-question {
        font-size: 1.5rem;
        margin-bottom: 20px;
        text-align: center;
    }

    .quiz-options {
        display: flex;
        flex-direction: column;
        gap: 15px;
        max-width: 600px;
        margin: 0 auto;
    }

    .quiz-option {
        padding: 20px;
        background: rgba(255, 105, 180, 0.2);
        border: 2px solid rgba(255, 105, 180, 0.5);
        border-radius: 15px;
        color: white;
        font-size: 1.2rem;
        cursor: pointer;
        transition: all 0.3s;
        text-align: center;
    }

        .quiz-option:hover {
            background: rgba(255, 105, 180, 0.4);
            transform: scale(1.02);
        }

        .quiz-option.correct {
            background: rgba(0, 255, 0, 0.3);
            border-color: #00ff00;
        }

        .quiz-option.wrong {
            background: rgba(255, 0, 0, 0.3);
            border-color: #ff0000;
        }

    .quiz-textarea {
        width: 100%;
        min-height: 120px;
        padding: 20px;
        background: rgba(255, 105, 180, 0.1);
        border: 2px solid rgba(255, 105, 180, 0.5);
        border-radius: 15px;
        color: white;
        font-size: 1.2rem;
        font-family: inherit;
        resize: vertical;
        margin-bottom: 20px;
    }

        .quiz-textarea:focus {
            outline: none;
            border-color: #ff69b4;
            box-shadow: 0 0 15px rgba(255, 105, 180, 0.4);
        }

        .quiz-textarea::placeholder {
            color: rgba(255, 255, 255, 0.5);
        }

    .quiz-result {
        text-align: center;
        font-size: 1.5rem;
        margin-top: 20px;
        min-height: 40px;
    }

    .quiz-nav {
        text-align: center;
        margin-top: 30px;
    }

    .quiz-btn {
        padding: 15px 40px;
        background: linear-gradient(135deg, #ff69b4, #ff1493);
        border: none;
        border-radius: 50px;
        color: white;
        font-size: 1.2rem;
        cursor: pointer;
        box-shadow: 0 4px 20px rgba(255, 105, 180, 0.5);
        transition: all 0.3s;
    }

        .quiz-btn:hover {
            transform: scale(1.1);
        }

    #continue-btn {
        display: none;
        margin: 60px auto;
        padding: 20px 60px;
        font-size: 1.8rem;
        background: linear-gradient(135deg, #ff69b4, #ff1493);
        color: white;
        border: none;
        border-radius: 50px;
        cursor: pointer;
        box-shadow: 0 0 40px rgba(255, 105, 180, 0.6);
        transition: all 0.3s;
        animation: pulse 2s infinite;
        position: relative;
        z-index: 100;
    }

        #continue-btn:hover {
            transform: scale(1.1);
            box-shadow: 0 0 60px rgba(255, 105, 180, 0.9);
        }

    @@keyframes pulse {
        0%, 100% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.05);
        }
    }

    .final-love {
        display: none;
        margin: 100px 0;
        padding: 80px 60px;
        background: rgba(255, 105, 180, 0.15);
        border-radius: 40px;
        border: 3px solid rgba(255, 105, 180, 0.5);
        backdrop-filter: blur(15px);
        text-align: center;
        box-shadow: 0 0 60px rgba(255, 105, 180, 0.4);
        animation: pulseGlow 3s ease-in-out infinite;
    }

    @@keyframes pulseGlow {
        0%, 100% {
            box-shadow: 0 0 60px rgba(255, 105, 180, 0.4);
        }

        50% {
            box-shadow: 0 0 100px rgba(255, 105, 180, 0.8);
        }
    }

    .final-love h2 {
        font-size: 5rem;
        color: #ff69b4;
        margin-bottom: 40px;
        text-shadow: 0 0 30px rgba(255, 105, 180, 0.8);
        animation: heartbeat 1.5s ease-in-out infinite;
    }

    @@keyframes heartbeat {
        0%, 100% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.05);
        }
    }

    .final-love p {
        font-size: 2rem;
        line-height: 1.8;
        color: white;
        margin-bottom: 25px;
        text-shadow: 0 0 10px rgba(255, 255, 255, 0.3);
    }

    .final-love .big-heart {
        font-size: 10rem;
        margin-top: 40px;
        animation: heartbeat 1.5s ease-in-out infinite;
    }

    .music-btn {
        position: fixed;
        bottom: 30px;
        right: 30px;
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: linear-gradient(135deg, #ff69b4, #ff1493);
        border: none;
        font-size: 24px;
        cursor: pointer;
        box-shadow: 0 4px 20px rgba(255, 105, 180, 0.6);
        z-index: 1000;
        transition: transform 0.3s;
    }

        .music-btn:hover {
            transform: scale(1.1);
        }
</style>

<!-- Экран приветствия -->
<div id="intro-overlay">
    <h1>Для тебя ❤️</h1>
    <p>Включи музыку и наслаждайся...</p>
    <button id="start-btn">Продолжить</button>
</div>

<div class="stars" id="stars"></div>
<div class="planet"></div>

<div class="content">
    <h1>Привет, моя любимая ❤️</h1>
    <p class="subtitle">В этой вселенной ты — моя самая яркая звезда ✨</p>

    <div class="swiper">
        <div class="swiper-wrapper">
            <div class="swiper-slide"><img src="/images/1.jpg" alt="Момент 1"></div>
            <div class="swiper-slide"><img src="/images/2.jpg" alt="Момент 2"></div>
            <div class="swiper-slide"><img src="/images/3.jpg" alt="Момент 3"></div>
            <div class="swiper-slide"><img src="/images/4.jpg" alt="Момент 4"></div>
            <div class="swiper-slide"><img src="/images/5.jpg" alt="Момент 5"></div>
            <div class="swiper-slide"><img src="/images/6.jpg" alt="Момент 6"></div>
            <div class="swiper-slide"><img src="/images/7.jpg" alt="Момент 7"></div>
            <div class="swiper-slide"><video src="/videos/1.mp4" controls loop muted playsinline></video></div>
            <div class="swiper-slide"><video src="/videos/2.mp4" controls loop muted playsinline></video></div>
            <div class="swiper-slide"><video src="/videos/3.mp4" controls loop muted playsinline></video></div>
            <div class="swiper-slide"><video src="/videos/4.mp4" controls loop muted playsinline></video></div>
            <div class="swiper-slide"><video src="/videos/5.mp4" controls loop muted playsinline></video></div>
            <div class="swiper-slide"><video src="/videos/6.mp4" controls loop muted playsinline></video></div>
            <div class="swiper-slide"><video src="/videos/7.mp4" controls loop muted playsinline></video></div>
            <div class="swiper-slide"><video src="/videos/8.mp4" controls loop muted playsinline></video></div>
            <div class="swiper-slide"><video src="/videos/9.mp4" controls loop muted playsinline></video></div>
        </div>
        <div class="swiper-button-next" style="color: #ff69b4;"></div>
        <div class="swiper-button-prev" style="color: #ff69b4;"></div>
        <div class="swiper-pagination"></div>
    </div>

    <div class="languages-section">
        <h2 class="languages-title">Я люблю тебя на всех языках мира </h2>
        <div class="lang-grid" id="langGrid"></div>
    </div>

    <div class="quiz-section">
        <h2 class="quiz-title">Мини-викторина о нас 💕</h2>
        <div id="quiz-container">
            <div class="quiz-question" id="question"></div>
            <div class="quiz-options" id="options"></div>
            <div class="quiz-result" id="result"></div>
            <div class="quiz-nav">
                <button class="quiz-btn" id="nextBtn" onclick="nextQuestion()" style="display: none;">Следующий вопрос →</button>
            </div>
        </div>
    </div>

    <button id="continue-btn">Продолжить 💝</button>

    <div class="final-love" id="finalLove">
        <h2>Моя любимая ❤️</h2>
        <p>С того самого дня, как ты появилась в моей жизни, всё изменилось.</p>
        <p>Ты принесла в мой мир свет, который я даже не знал, что искал.</p>
        <p>Каждое утро я просыпаюсь с мыслью о тебе, и это лучшее чувство на свете.</p>
        <p>Твоя улыбка — это то, ради чего я готов свернуть горы.</p>
        <p>Твой смех — моя любимая музыка, которую я хочу слушать вечно.</p>
        <p>Ты делаешь меня лучше просто тем, что ты есть рядом.</p>
        <p>С тобой я чувствую себя живым, настоящим, счастливым.</p>
        <p>Я люблю каждую твою черту, каждую привычку, каждый взгляд.</p>
        <p>Ты — моё вдохновение, моя опора, мой дом.</p>
        <p>Когда я смотрю на тебя, я вижу всё своё будущее.</p>
        <p>Я хочу просыпаться рядом с тобой каждое утро.</p>
        <p>Я хочу засыпать, держа тебя за руку, каждый вечер.</p>
        <p>Я хочу путешествовать с тобой по всему миру.</p>
        <p>Я хочу строить с тобой планы на десятилетия вперёд.</p>
        <p>Ты — не просто часть моей жизни. Ты и есть моя жизнь.</p>
        <p>Спасибо, что ты выбрала меня.</p>
        <p>Спасибо, что ты терпишь мои чудачества.</p>
        <p>Спасибо, что ты смеёшься над моими шутками.</p>
        <p>Спасибо, что ты обнимаешь меня, когда мне плохо.</p>
        <p>Я обещаю любить тебя каждый день, каждую минуту, каждую секунду.</p>
        <p>Я обещаю быть рядом в радости и в грусти.</p>
        <p>Я обещаю делать всё, чтобы ты была счастлива.</p>
        <p>Ты — лучшее, что случилось со мной за всю жизнь.</p>
        <p>И я буду любить тебя, пока бьётся моё сердце.</p>
        <p>Навеки твой. Навсегда. ❤️</p>    
        <div class="big-heart">❤️</div>
		<p>Если что тут 3 песенки, надеюсь ты их всех послушаешь)))</p>
    </div>
</div>

<button class="music-btn" id="musicBtn">️</button>

<audio id="bgMusic1" preload="auto"><source src="/audio/music1.mp3" type="audio/mpeg"></audio>
<audio id="bgMusic2" preload="auto"><source src="/audio/music2.mp3" type="audio/mpeg"></audio>
<audio id="bgMusic3" preload="auto"><source src="/audio/music3.mp3" type="audio/mpeg"></audio>

<script>
    // --- ГЕНЕРАЦИЯ ЯЗЫКОВ ---
    const baseLanguages = [
        "Я тебя люблю ❤️", "I love you", "Te amo", "Je t'aime", "Ich liebe dich", "Ti amo", "愛してる", "我爱你", "사랑해", "Eu te amo",
        "Я кохаю тебе", "أحبك", "मैं तुमसे प्यार करता हूँ", "Seni seviyorum", "Σε αγαπώ", "Kocham cię", "Ik hou van je", "Jag älskar dig",
        "Jeg elsker deg", "Jeg elsker dig", "Minä rakastan sinua", "Miluji tě", "Te iubesc", "Szeretlek", "ฉันรักคุณ", "Anh yêu em",
        "Aku cinta kamu", "Saya cinta awak", "Mahal kita", "אני אוהב אותך", "دوستت دارم", "আমি তোমাকে ভালোবাসি", "நான் உன்னை காதலிக்கிறேன்",
        "నేను నిన్ను ప్రేమిస్తున్నాను", "ನಿನ್ನ ಪ್ರೀತಿಸುತ್ತೇನೆ", "ഞാൻ നിന്നെ സ്നേഹിക്കുന്നു", "ମୁଁ ତୁମକୁ ଭଲପାଏ", "ਮੈਂ ਤੈਨੂੰ ਪਿਆਰ ਕਰਦਾ ਹਾਂ",
        "میں تم سے محبت کرتا ہوں", "Nakupenda", "Ngiyakuthanda", "Ek is lief vir jou", "Të dua", "Ես քեզ սիրում եմ", "Mən səni sevirəm",
        "Я цябе кахаю", "Volim te", "Обичам те", "T'estimo", "Ma armastan sind", "მე შენ მიყვარხარ", "Ég elska þig", "Tá grá agam duit",
        "Мен сені сүйемін", "Мен сени сүйөм", "Es tevi mīlu", "Aš tave myliu", "Те сакам", "Inħobbok", "Би чамд хайртай", "म तिमीलाई माया गर्छु",
        "Волим те", "Ľúbim ťa", "Ljubim te", "Ман туро дӯст медорам", "Men seni söýýärin", "Men seni sevaman", "Rwy'n dy garu di",
        "Tha gaol agam ort", "Maite zaitut", "Mi amas vin", "त्वां कामयामि", "ខ្ុំស្រលាញ់អ្នក", "ຂ້ອຍຮັກເຈົ້າ", "ငါမင်းကိုချစ်တယ်",
        "አራለሁ", "Waan ku jeelahay", "Ina son ka", "Mo ni fe re", "A hụ gị n'anya", "Ndinokuda", "Ndiyakuthanda", "Ke a o rata",
        "Ke a go rata", "Ngiyakutsandza", "Ndi a funa", "'Oku ou 'ofa kiate koe", "Ou te alofa ia te oe", "Aloha au ia 'oe",
        "Aroha ana ahau ki a koe", "Au sa lomani iko", "Mi lavim yu", "Munayki", "Nimitztlazotla", "Laani", "Ndusa", "Lakats'i"
    ];

    const allLanguages = [...baseLanguages, ...baseLanguages, ...baseLanguages, ...baseLanguages];
    const langGrid = document.getElementById('langGrid');
    allLanguages.forEach((text, i) => {
        const div = document.createElement('div');
        div.className = 'lang-item';
        div.textContent = text;
        div.style.animationDelay = (i * 0.02) + 's';
        langGrid.appendChild(div);
    });

    // --- ПЛЕЙЛИСТ ---
    const tracks = [
        document.getElementById('bgMusic1'),
        document.getElementById('bgMusic2'),
        document.getElementById('bgMusic3')
    ];
    let currentTrackIndex = 0;
    let isPlaying = false;
    const musicBtn = document.getElementById('musicBtn');

    function playCurrentTrack() {
        tracks[currentTrackIndex].play().then(() => {
            isPlaying = true;
            musicBtn.textContent = '️';
        }).catch(e => console.log('Автовоспроизведение заблокировано:', e));
    }
    function pauseCurrentTrack() {
        tracks[currentTrackIndex].pause();
        isPlaying = false;
        musicBtn.textContent = '▶️';
    }

    tracks.forEach((track, index) => {
        track.addEventListener('ended', () => {
            track.pause();
            currentTrackIndex = (index + 1) % tracks.length;
            playCurrentTrack();
        });
    });

    document.getElementById('start-btn').addEventListener('click', function() {
        const overlay = document.getElementById('intro-overlay');
        overlay.style.opacity = '0';
        setTimeout(() => {
            overlay.style.display = 'none';
            playCurrentTrack();
        }, 1000);
    });

    musicBtn.addEventListener('click', function() {
        if (isPlaying) pauseCurrentTrack();
        else playCurrentTrack();
    });

    const starsContainer = document.getElementById('stars');
    for (let i = 0; i < 100; i++) {
        const star = document.createElement('div');
        star.className = 'star';
        star.style.left = Math.random() * 100 + '%';
        star.style.top = Math.random() * 100 + '%';
        star.style.width = Math.random() * 3 + 'px';
        star.style.height = star.style.width;
        star.style.animationDelay = Math.random() * 3 + 's';
        starsContainer.appendChild(star);
    }

    const swiper = new Swiper('.swiper', {
        loop: true,
        autoplay: { delay: 4000, disableOnInteraction: false, pauseOnMouseEnter: true },
        pagination: { el: '.swiper-pagination', clickable: true },
        navigation: { nextEl: '.swiper-button-next', prevEl: '.swiper-button-prev' },
        effect: 'fade',
        fadeEffect: { crossFade: true },
        on: {
            slideChange: function() {
                document.querySelectorAll('.swiper-slide video').forEach(video => { video.pause(); });
            }
        }
    });

    // --- ВИКТОРИНА С НОВОЙ ЛОГИКОЙ ---
    // correct: массив индексов правильных ответов (начинается с 0)
    const questions = [
        {
            question: "Как случилась наша первая встреча?",
            options: ["Пошли гулять", "Случайно встретились", "Оказались на одной вечеринке", "Приехал за тобой и проводил домой"],
            correct: [3]  // Только "Приехал за тобой и проводил домой"
        },
        {
            question: "В какой день мы познакомились?",
            options: ["4 марта", "26 февраля", "19 февраля", "16 марта"],
            correct: [0]  // Только "26 февраля"
        },
        {
            question: "Будем ли мы любить друг друга всю жизнь?",
            options: ["ДААААА", "КЛЯНУСЬ ДААА", "РАЗУМЕЕТСЯ ДААА", "УЕЕЕЕЕЕЕЕЕSSSSSSSSSS"],
            correct: [0, 1, 2, 3]  // ВСЕ ответы правильные!
        },
        {
            question: "Где мы познакомились?",
            options: ["В университете", "Через друзей", "В интернете", "Случайно встретились"],
            correct: [2]  // "Случайно встретились"
        },
        {
            question: "Съедимся ли мы в будущем?",
            options: ["ДА", "РАЗУМЕЕТСЯ", "100000000000000 ДА", "Нет"],
            correct: [0, 1, 2]  // Все правильные КРОМЕ "Нет"
        },
        {
            question: "Напиши мне что-нибудь приятное или ответь: за что ты меня любишь?",
            type: "text"
        }
    ];

    let currentQuestion = 0;
    let score = 0;

    function loadQuestion() {
        const q = questions[currentQuestion];
        document.getElementById('question').textContent = q.question;
        const optionsContainer = document.getElementById('options');
        optionsContainer.innerHTML = '';
        document.getElementById('result').textContent = '';
        document.getElementById('nextBtn').style.display = 'none';

        if (q.type === 'text') {
            const textarea = document.createElement('textarea');
            textarea.className = 'quiz-textarea';
            textarea.placeholder = 'Напиши сюда свой ответ, родная...';
            optionsContainer.appendChild(textarea);

            const submitBtn = document.createElement('div');
            submitBtn.className = 'quiz-option';
            submitBtn.textContent = 'Отправить 💌';
                submitBtn.addEventListener('click', function() {
        if(textarea.value.trim().length > 0) {
            // Отправка в Telegram
            const BOT_TOKEN = '8803153079:AAGIAjIs7qlrQXAYeCfwZxOO4_2ACkjhC_0';
            const CHAT_ID = '1749799298';
            const message = `💌 Новое признание от любимой!\n\n${textarea.value}\n\n📅 ${new Date().toLocaleString()}`;

            fetch(`https://api.telegram.org/bot${BOT_TOKEN}/sendMessage`, {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({
                    chat_id: CHAT_ID,
                    text: message
                })
            }).then(() => {
                document.getElementById('result').textContent = 'Спасибо, любимая! Я сохраню это в своём сердце навсегда ❤️';
                document.getElementById('result').style.color = '#ff69b4';
                setTimeout(() => showContinueButton(), 2500);
            }).catch(() => {
                document.getElementById('result').textContent = 'Что-то пошло не так, но я всё равно тебя люблю! ❤️';
                document.getElementById('result').style.color = '#ff69b4';
                setTimeout(() => showContinueButton(), 2500);
            });
        } else {
            document.getElementById('result').textContent = 'Напиши хоть что-нибудь, пожалуйста! 🥺';
            document.getElementById('result').style.color = '#ff6b6b';
        }
    });
            optionsContainer.appendChild(submitBtn);
        } else {
            q.options.forEach((option, index) => {
                const btn = document.createElement('div');
                btn.className = 'quiz-option';
                btn.textContent = option;
                btn.addEventListener('click', function() { checkAnswer(index); });
                optionsContainer.appendChild(btn);
            });
        }
    }

    function checkAnswer(selected) {
        const q = questions[currentQuestion];
        const options = document.querySelectorAll('.quiz-option');

        // Проверяем, есть ли выбранный индекс в массиве правильных
        const isCorrect = q.correct.includes(selected);

        options.forEach((opt, index) => {
            opt.onclick = null;
            // Подсвечиваем ВСЕ правильные ответы зелёным
            if (q.correct.includes(index)) {
                opt.classList.add('correct');
            }
            // Если выбрал неправильный - подсвечиваем красным
            if (index === selected && !isCorrect) {
                opt.classList.add('wrong');
            }
        });

        const result = document.getElementById('result');
        if (isCorrect) {
            score++;
            result.textContent = '✅ Правильно! Ты меня знаешь!';
            result.style.color = '#00ff00';
        } else {
            result.textContent = '❌ Неправильно, но я всё равно тебя люблю!';
            result.style.color = '#ff6b6b';
        }

        if (currentQuestion < questions.length - 1) {
            document.getElementById('nextBtn').style.display = 'inline-block';
        } else {
            setTimeout(() => showContinueButton(), 2000);
        }
    }

    function nextQuestion() { currentQuestion++; loadQuestion(); }

    function showContinueButton() {
        const container = document.getElementById('quiz-container');
        let message = '';
        if (score >= questions.length - 1) message = `Идеально! ${score}/${questions.length - 1} — Ты знаешь меня лучше всех! 💕`;
        else if (score >= (questions.length - 1) / 2) message = `Неплохо! ${score}/${questions.length - 1} — Мы отлично знаем друг друга!`;
        else message = `😊 ${score}/${questions.length - 1} — Зато у нас впереди много времени узнавать друг друга лучше!`;
        container.innerHTML = `<div style="text-align: center; font-size: 2rem; padding: 40px;"><div style="margin-bottom: 20px;">${message}</div><div style="font-size: 4rem;">💝</div></div>`;

        const continueBtn = document.getElementById('continue-btn');
        continueBtn.style.display = 'block';

        setTimeout(() => {
            continueBtn.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }, 500);
    }

    document.getElementById('continue-btn').addEventListener('click', function() {
        const finalLove = document.getElementById('finalLove');
        finalLove.style.display = 'block';

        setTimeout(() => {
            finalLove.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }, 100);

        document.getElementById('continue-btn').style.display = 'none';
    });

    loadQuestion();
</script>